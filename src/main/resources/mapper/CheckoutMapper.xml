    <select id="selectSaleLinesBySaleKey" resultMap="SaleLineRowMap">
        SELECT SALE_LINE_ID,
               SALE_ID,
               LINE_NO,
               BARCODE,
               NAME,
               UNIT_PRICE,
               QTY,
               AMOUNT,
               ITEM_STATUS
        FROM SALE_LINES
        WHERE SALE_ID = (SELECT SALE_ID
                         FROM SALES
                         WHERE STORE_CD = #{storeCd}
                           AND POS_NO = #{posNo}
                           AND TRAN_NO = #{tranNo})
        ORDER BY LINE_NO ASC
    </select>

    <select id="selectPaymentBySaleKey" resultMap="PaymentRowMap">
        SELECT PAYMENT_ID,
               SALE_ID,
               METHOD,
               STATUS,
               AMOUNT_DUE_TO_PAY,
               APPROVED_AT
        FROM PAYMENTS
        WHERE SALE_ID = (SELECT SALE_ID
                         FROM SALES
                         WHERE STORE_CD = #{storeCd}
                           AND POS_NO = #{posNo}
                           AND TRAN_NO = #{tranNo})
        ORDER BY APPROVED_AT DESC
        LIMIT 1
    </select>

    <select id="selectCashPaymentById" resultMap="CashPaymentRowMap">
        SELECT PAYMENT_ID, AMOUNT_RECEIVED, CHANGE
        FROM CASH_PAYMENTS
        WHERE 1 = 1
          and PAYMENT_ID = #{paymentId}
    </select>

</mapper>
